{
  "name": "@stonekeep/mcp",
  "version": "0.7.0",
  "description": "Stonekeep MCP server: scan, plan and dry-run tools for AI coding agents (no destructive tools).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "stonekeep-mcp": "./bin/stonekeep-mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@stonekeep/ai": "workspace:*",
    "@stonekeep/connectors": "workspace:*",
    "@stonekeep/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "keywords": [
    "gdpr",
    "rodo",
    "privacy",
    "compliance",
    "poland"
  ],
  "publishConfig": {
    "access": "public"
  }
}
