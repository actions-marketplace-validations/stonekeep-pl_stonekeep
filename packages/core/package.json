{
  "name": "@stonekeep/core",
  "version": "0.8.0",
  "description": "Stonekeep core: PII scanner, rule-based classifier and datamap checks.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js"
    },
    "./consent": {
      "types": "./dist/consent/index.d.ts",
      "import": "./dist/consent/index.js"
    },
    "./rules/default-rules.json": "./rules/default-rules.json"
  },
  "files": [
    "dist",
    "rules"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "better-sqlite3": "^12.11.1",
    "fflate": "^0.8.3",
    "pg": "^8.23.1",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "keywords": [
    "gdpr",
    "rodo",
    "privacy",
    "compliance",
    "poland"
  ],
  "publishConfig": {
    "access": "public"
  }
}
