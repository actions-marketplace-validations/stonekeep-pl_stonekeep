    {
      "id": "cee-financial",
      "category": "financial",
      "description": "Bank account fields in Polish, Romanian and Hungarian.",
      "match": [
        {
          "pattern": "(^|_)(numer_konta|nr_konta|nr_rachunku|numer_rachunku|rachunek_bankowy|konto_bankowe|cont_bancar|numar_cont|bankszamlaszam|szamlaszam)($|_)",
          "confidence": 0.93
