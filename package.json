{
  "name": "stonekeep-monorepo",
  "private": true,
  "version": "0.8.0",
  "description": "Stonekeep: automated user data compliance tooling (open core).",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc -p packages/core/tsconfig.json && tsc -p packages/connectors/tsconfig.json && tsc -p packages/cli/tsconfig.json && tsc -p packages/react/tsconfig.json && tsc -p packages/ai/tsconfig.json && tsc -p packages/mcp/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:ai": "pnpm --filter @stonekeep/ai run eval"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@eslint/js": "^9.36.0",
    "@testcontainers/postgresql": "^11.14.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fast-check": "^4.10.2",
    "fflate": "^0.8.3",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "prettier": "^3.6.2",
    "supertest": "^7.3.2",
    "testcontainers": "^11.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
